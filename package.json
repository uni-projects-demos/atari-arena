{
  "name": "atari-arena",
  "version": "1.0.0",
  "description": "Evaluate & play trained models against Atari game engines, users & other models. Supports user vs game mode.",
  "private": true,
  "type": "module",
  "author": "uni-project-demos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-project-demos/atari-arena.git"
  },
  "bugs": {
    "url": "https://github.com/uni-project-demos/atari-arena/issues"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:browser": "node engine/tools/vite.mjs dev",
    "build": "vite build",
    "build:pages": "node engine/tools/vite.mjs pages",
    "build:wasm": "node engine/tools/build.mjs",
    "build:browser": "node engine/tools/vite.mjs build",
    "preview": "vite preview",
    "verify": "biome check . && tsc -p tsconfig.verify.json --noEmit",
    "verify:rust": "cargo fmt --manifest-path engine/Cargo.toml --all -- --check && cargo clippy --manifest-path engine/Cargo.toml --workspace --all-targets -- -D warnings",
    "verify:all": "npm run verify && npm run verify:rust",
    "verify:fix": "biome check --write . && tsc -p tsconfig.verify.json --noEmit && npm run verify:rust"
  },
  "dependencies": {
    "@atari-arena/browser": "file:engine/browser",
    "clsx": "^2.1.1",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@farama/ale-wasm": "0.12.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "sass": "^1.108.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "protobufjs@7.6.6": true
  }
}
